generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserPlan {
  FREE
  PRO
}

enum ProfileKind {
  PERSON
  HOUSEHOLD
  BUSINESS
}

enum DocumentType {
  BOLLETTA_LUCE
  BOLLETTA_GAS
  BOLLETTA_INTERNET
  BUSTA_PAGA
}

enum AnalysisStatus {
  PENDING
  PROCESSING
  AWAITING_CONFIRMATION
  DONE
  ERROR
  DELETED
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  password            String
  plan                UserPlan             @default(FREE)
  documents           Document[]
  profiles            AnalysisProfile[]
  passwordResetTokens PasswordResetToken[]
  createdAt           DateTime             @default(now())
}

model AnalysisProfile {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  kind      ProfileKind @default(PERSON)
  isDefault Boolean     @default(false)
  documents Document[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Document {
  id                 String          @id @default(cuid())
  userId             String
  user               User            @relation(fields: [userId], references: [id])
  profileId          String
  profile            AnalysisProfile @relation(fields: [profileId], references: [id], onDelete: Restrict)
  type               DocumentType
  filePath           String?
  fileName           String
  status             AnalysisStatus  @default(PENDING)
  rawExtracted       Json?
  analysis           Json?
  anonymizedText     String?
  anonymizedMap      Json?
  typeCorrected      Boolean         @default(false)
  typeSelectedByUser String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  deletedAt          DateTime?

  @@index([profileId])
}

model MarketRate {
  id               String   @id @default(cuid())
  category         String
  provider         String
  planName         String
  priceValue       Float
  priceUnit        String
  monthlyFee       Float?
  url              String?
  scrapedAt        DateTime @default(now())
  offertaInizio    DateTime?
  offertaFine      DateTime?
  tipoOfferta      String?
  durataEsclusive  Int?

  @@unique([provider, planName])
}
