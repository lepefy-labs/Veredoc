generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserPlan {
  FREE
  PRO
}

enum ProfileKind {
  PERSON
  HOUSEHOLD
  BUSINESS
}

enum DocumentType {
  BOLLETTA_LUCE
  BOLLETTA_GAS
  BOLLETTA_INTERNET
  BUSTA_PAGA
}

enum NotificationEventType {
  ANALYSIS_DELAYED
  ANALYSIS_COMPLETED
  ANALYSIS_FAILED
}

enum NotificationStatus {
  PENDING
  SENDING
  SENT
  FAILED
  CANCELLED
}

enum AnalysisStatus {
  PENDING
  PROCESSING
  AWAITING_CONFIRMATION
  DONE
  ERROR
  DELETED
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  password            String
  plan                UserPlan             @default(FREE)
  documents           Document[]
  profiles            AnalysisProfile[]
  passwordResetTokens PasswordResetToken[]
  notifications       NotificationOutbox[]
  consents            UserConsent[]
  accountState        AccountState?
  emailTokens         EmailToken[]
  cases               UserCase[]
  knowledgeAudits     KnowledgeAudit[]
  createdAt           DateTime             @default(now())
}

model AnalysisProfile {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  kind      ProfileKind @default(PERSON)
  isDefault Boolean     @default(false)
  documents Document[]
  cases     UserCase[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Document {
  id                 String          @id @default(cuid())
  userId             String
  user               User            @relation(fields: [userId], references: [id])
  profileId          String
  profile            AnalysisProfile @relation(fields: [profileId], references: [id], onDelete: Restrict)
  type               DocumentType
  filePath           String?
  fileName           String
  status             AnalysisStatus  @default(PENDING)
  rawExtracted       Json?
  analysis           Json?
  anonymizedText     String?
  anonymizedMap      Json?
  typeCorrected      Boolean         @default(false)
  typeSelectedByUser String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  deletedAt          DateTime?
  notifications      NotificationOutbox[]

  @@index([profileId])
}

// Transactional outbox delle email di servizio (supabase/migrations/003_notification_outbox.sql).
// L'id è un UUID v4 e viene usato come idempotencyKey Brevo per tutti i tentativi della stessa riga.
// Il destinatario non viene copiato: l'email è letta da User al momento dell'invio.
model NotificationOutbox {
  id                String                @id @default(uuid())
  userId            String
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentId        String
  document          Document              @relation(fields: [documentId], references: [id], onDelete: Cascade)
  eventType         NotificationEventType
  eventKey          String                @unique
  analysisCycle     Int
  status            NotificationStatus    @default(PENDING)
  attempts          Int                   @default(0)
  nextAttemptAt     DateTime              @default(now())
  leaseId           String?
  leaseExpiresAt    DateTime?
  lastSendStartedAt DateTime?
  ambiguousSince    DateTime?
  sentAt            DateTime?
  lastErrorCode     String?
  providerMessageId String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([status, nextAttemptAt])
  @@index([documentId])
  @@index([userId])
}

model MarketRate {
  id               String   @id @default(cuid())
  category         String
  provider         String
  planName         String
  priceValue       Float
  priceUnit        String
  monthlyFee       Float?
  url              String?
  scrapedAt        DateTime @default(now())
  offertaInizio    DateTime?
  offertaFine      DateTime?
  tipoOfferta      String?
  durataEsclusive  Int?

  @@unique([provider, planName])
}

// Prova del consenso a Privacy Policy e Termini (supabase/migrations/004_account_security.sql).
model UserConsent {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       String
  version    String
  acceptedAt DateTime @default(now())

  @@index([userId])
}

// Contatori del rate limit (004_account_security.sql). key = SHA-256 di regola + soggetto.
model RateLimitBucket {
  key         String   @id
  windowStart DateTime @default(now())
  count       Int      @default(0)

  @@index([windowStart])
}

// Stato di sicurezza dell'account (supabase/migrations/005_account_lifecycle.sql).
// Assenza di riga = account precedente alla migrazione.
model AccountState {
  userId          String    @id
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailVerifiedAt DateTime?
  sessionVersion  Int       @default(0)
  updatedAt       DateTime  @default(now())
}

// Token monouso per verifica e cambio email (005_account_lifecycle.sql). Solo hash.
model EmailToken {
  id        String    @id
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   String
  tokenHash String    @unique
  newEmail  String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model KnowledgeSource {
  id             String              @id @default(cuid())
  authority      String
  title          String
  url            String              @unique
  sourceType     String
  scope          String
  status         String              @default("DRAFT")
  provenance     Json?
  acquiredAt     DateTime            @default(now())
  verifiedAt     DateTime?
  revisions      KnowledgeRevision[]
  citations      ProcedureCitation[]
}

model KnowledgeRevision {
  id            String              @id @default(cuid())
  sourceId      String
  source        KnowledgeSource     @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  version       Int
  content       String
  contentHash   String
  acquiredAt    DateTime            @default(now())
  effectiveAt   DateTime?
  status        String              @default("DRAFT")
  diff          Json?
  citations     ProcedureCitation[]

  @@unique([sourceId, version])
  @@unique([sourceId, contentHash])
}

model ProcedureDefinition {
  id          String             @id @default(cuid())
  slug        String             @unique
  title       String
  description String
  category    String
  audience    String
  scope       String
  authority   String
  status      String             @default("DRAFT")
  metadata    Json?
  versions    ProcedureVersion[]
}

model ProcedureVersion {
  id            String              @id @default(cuid())
  procedureId   String
  procedure     ProcedureDefinition @relation(fields: [procedureId], references: [id], onDelete: Restrict)
  version       Int
  definition    Json
  status        String              @default("DRAFT")
  approvedAt    DateTime?
  effectiveAt   DateTime?
  createdAt     DateTime            @default(now())
  citations     ProcedureCitation[]
  cases         UserCase[]

  @@unique([procedureId, version])
  // Indice parziale per una sola versione PUBLISHED in 006_pratiche.sql.
}

model ProcedureCitation {
  id                String            @id @default(cuid())
  procedureVersionId String
  procedureVersion  ProcedureVersion  @relation(fields: [procedureVersionId], references: [id], onDelete: Restrict)
  sourceId          String
  source            KnowledgeSource   @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  revisionId        String
  revision          KnowledgeRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  instructionIds    String[]

  @@unique([procedureVersionId, revisionId])
}

model UserCase {
  id                 String           @id @default(cuid())
  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileId          String?
  profile            AnalysisProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  procedureVersionId String
  procedureVersion   ProcedureVersion @relation(fields: [procedureVersionId], references: [id], onDelete: Restrict)
  title              String
  status             String           @default("DRAFT")
  revision           Int              @default(0)
  idempotencyKey     String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  completedAt        DateTime?
  answers            CaseAnswer[]
  steps              CaseStep[]
  events             CaseEvent[]

  @@index([userId, updatedAt])
  @@index([profileId])
  @@unique([userId, idempotencyKey])
}

model CaseAnswer {
  caseId      String
  case        UserCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  questionId  String
  value       Json
  revision    Int
  updatedAt   DateTime @updatedAt

  @@id([caseId, questionId])
}

model CaseStep {
  caseId      String
  case        UserCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  stepId      String
  status      String
  completedAt DateTime?
  metadata    Json?

  @@id([caseId, stepId])
}

model CaseEvent {
  id        String   @id @default(cuid())
  caseId    String
  case      UserCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  type      String
  actorId   String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([caseId, createdAt])
}

model KnowledgeAudit {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  entityType String
  entityId   String
  action     String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
}
