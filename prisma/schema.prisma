generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserPlan {
  FREE
  PRO
}

enum ProfileKind {
  PERSON
  HOUSEHOLD
  BUSINESS
}

enum DocumentType {
  BOLLETTA_LUCE
  BOLLETTA_GAS
  BOLLETTA_INTERNET
  BUSTA_PAGA
}

enum NotificationEventType {
  ANALYSIS_DELAYED
  ANALYSIS_COMPLETED
  ANALYSIS_FAILED
}

enum NotificationStatus {
  PENDING
  SENDING
  SENT
  FAILED
  CANCELLED
}

enum AnalysisStatus {
  PENDING
  PROCESSING
  AWAITING_CONFIRMATION
  DONE
  ERROR
  DELETED
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  password            String
  plan                UserPlan             @default(FREE)
  documents           Document[]
  profiles            AnalysisProfile[]
  passwordResetTokens PasswordResetToken[]
  notifications       NotificationOutbox[]
  createdAt           DateTime             @default(now())
}

model AnalysisProfile {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  kind      ProfileKind @default(PERSON)
  isDefault Boolean     @default(false)
  documents Document[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Document {
  id                 String          @id @default(cuid())
  userId             String
  user               User            @relation(fields: [userId], references: [id])
  profileId          String
  profile            AnalysisProfile @relation(fields: [profileId], references: [id], onDelete: Restrict)
  type               DocumentType
  filePath           String?
  fileName           String
  status             AnalysisStatus  @default(PENDING)
  rawExtracted       Json?
  analysis           Json?
  anonymizedText     String?
  anonymizedMap      Json?
  typeCorrected      Boolean         @default(false)
  typeSelectedByUser String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  deletedAt          DateTime?
  notifications      NotificationOutbox[]

  @@index([profileId])
}

// Transactional outbox delle email di servizio (supabase/migrations/003_notification_outbox.sql).
// L'id è un UUID v4 e viene usato come idempotencyKey Brevo per tutti i tentativi della stessa riga.
// Il destinatario non viene copiato: l'email è letta da User al momento dell'invio.
model NotificationOutbox {
  id                String                @id @default(uuid())
  userId            String
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentId        String
  document          Document              @relation(fields: [documentId], references: [id], onDelete: Cascade)
  eventType         NotificationEventType
  eventKey          String                @unique
  analysisCycle     Int
  status            NotificationStatus    @default(PENDING)
  attempts          Int                   @default(0)
  nextAttemptAt     DateTime              @default(now())
  leaseId           String?
  leaseExpiresAt    DateTime?
  lastSendStartedAt DateTime?
  ambiguousSince    DateTime?
  sentAt            DateTime?
  lastErrorCode     String?
  providerMessageId String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([status, nextAttemptAt])
  @@index([documentId])
  @@index([userId])
}

model MarketRate {
  id               String   @id @default(cuid())
  category         String
  provider         String
  planName         String
  priceValue       Float
  priceUnit        String
  monthlyFee       Float?
  url              String?
  scrapedAt        DateTime @default(now())
  offertaInizio    DateTime?
  offertaFine      DateTime?
  tipoOfferta      String?
  durataEsclusive  Int?

  @@unique([provider, planName])
}
